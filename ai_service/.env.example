# Настройка модели для векторизации материалов 
MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Настройка БД
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=
DB_NAME=

# Настройка сервера ИИ
PORT=8002
HOST=localhost

# Настройка адресов основного сервера
MAIN_SERVER_URL=http://localhost:5001
MAIN_SERVER_LOGS_ENDPOINT=/api/admin/parser/logs

# RAG: каталог chunks.jsonl (конвертер). Индекс: python -m app.index_chunks
CONVERTED_DIR=../doc_converter/data/converted

# Облачная LLM для ответа на вкладке поиска. Ключ можно не дублировать:
# сервис читает и этот файл, и doc_converter/.env
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash