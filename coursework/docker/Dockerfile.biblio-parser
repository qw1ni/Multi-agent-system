# Сборка зависимостей отдельно, чтобы в итоговом образе не остались gcc и кэш pip.
# База python:3.11-slim меньше полного python:3.11.
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build
COPY biblio_parser/requirements.txt .
RUN pip install --prefix=/install -r requirements.txt uvicorn

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    REQUIRED_VARS="DB_USER DB_PASSWORD DB_HOST DB_PORT DB_NAME PORT HOST"

WORKDIR /app
COPY --from=builder /install /usr/local
COPY biblio_parser/app ./app
COPY coursework/docker/entrypoint.sh /entrypoint.sh

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin app \
    && mkdir -p /data/downloads \
    && chown -R app:app /app /data/downloads \
    && chmod +x /entrypoint.sh

USER app
EXPOSE 8001
ENTRYPOINT ["/entrypoint.sh"]
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
