FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build
COPY agents/requirements.txt .
RUN pip install --prefix=/install -r requirements.txt

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    REQUIRED_VARS="PARSER_SERVER_URL PORT"

WORKDIR /app
COPY --from=builder /install /usr/local
COPY agents/parser_agent ./parser_agent
COPY coursework/docker/agent_health.py ./agent_health.py
COPY coursework/docker/entrypoint.sh /entrypoint.sh

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin app \
    && chown -R app:app /app \
    && chmod +x /entrypoint.sh

USER app
EXPOSE 8003
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "agent_health.py"]
