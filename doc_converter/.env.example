# Откуда брать скачанные материалы (biblio_parser/data/downloads)
DOWNLOAD_DIR=../biblio_parser/data/downloads
# Куда класть результаты: <раздел>/<файл>/document.md, document.json, chunks.jsonl, meta.json
# + manifest.jsonl (весь корпус и по разделам) — с него LLM-пайплайн берёт готовые документы
CONVERTED_DIR=data/converted

# OCR нужен только для сканов: текстовые PDF читаются без него
OCR_ENABLED=true
OCR_LANGS=ru,en

# HTTP API конвертера (для админки сайта)
CONVERTER_HOST=127.0.0.1
CONVERTER_PORT=8004

# Куда слать логи — консоль мониторинга в админке
MAIN_SERVER_URL=http://localhost:5001
MAIN_SERVER_LOGS_ENDPOINT=/api/admin/parser/logs

# auto | cpu | mps (видеочип Apple Silicon)
DOCLING_DEVICE=auto
# Потоков на одного агента роя
DOCLING_THREADS=4

# Рой агентов: каждый агент — отдельный процесс со своим разделом («ОКРБ 011-2009», «Факультеты», …).
# Каждый держит свои модели Docling (~1.5–3 ГБ ОЗУ). 0 = ядра / DOCLING_THREADS, но не больше 4
CONVERTER_SWARM_AGENTS=0
# Раздел больше N файлов делится на части, чтобы его тянули несколько агентов (0 — не делить)
CONVERTER_SWARM_SPLIT_SIZE=200
# Сколько раз перезапускать агента, если его процесс упал (файл, на котором он упал, помечается ошибкой)
CONVERTER_AGENT_MAX_RESTARTS=3
# Если один файл конвертируется дольше N секунд — агент перезапускается, файл помечается ошибкой
CONVERTER_FILE_TIMEOUT=1200

# Чанки для LLM / RAG. Токенизатор = модель эмбеддингов ai_service (MODEL_NAME),
# лимит = её окно: у paraphrase-multilingual-MiniLM-L12-v2 это 128 токенов, длиннее — обрежется.
# Сменили модель эмбеддингов — поменяйте оба значения и запустите конвертацию заново
# (OCR повторно не делается: чанки пересобираются из document.json)
CHUNK_TOKENIZER=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_MAX_TOKENS=128
